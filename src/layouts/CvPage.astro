---
// The CV on one A4 page, for one language: the same layout as the printed CV of February 2026 (Inter, a round photo,
// micro-label sections, bullets led by a bold title): each experience's lead (as on the home page), each achievement's
// title and CV text, written in English first. On screen it is the sheet itself, on a grey desk; it prints on A4
// (src/styles/print.css) and is exported to PDF at build time (tools/render-pdf.mjs), from this very page.
// English at /cv/, French at /fr/cv/. No script.
import { getEntry } from 'astro:content';
import '../styles/cv-page.css';
import Head from '../components/Head.astro';
import CvIdentity from '../components/CvIdentity.astro';
import CvSection from '../components/CvSection.astro';
import CvJob from '../components/CvJob.astro';
import { md } from '../lib/text';
import { pathOf, pdfPathOf, type Lang } from '../lib/i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
const entry = await getEntry('cv', lang);
if (!entry) throw new Error(`Missing content: src/content/cv/${lang}.json`);
const d = entry.data, ui = d.ui;
const fullName = `${d.identity.first_name} ${d.identity.last_name}`;
const home = pathOf(lang);
---
<!DOCTYPE html>
<html lang={lang}>
<head>
  <Head lang={lang} d={d} fullName={fullName} page="cv" />
</head>
<body class="cv-page">
  <nav class="cv-bar" aria-label={ui.nav_aria}>
    <a class="cv-back" href={home}><span aria-hidden="true">&larr;</span> {ui.cv_page.back}</a>
    <a class="cv-pdf" href={pdfPathOf(lang)} download><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 4v11M7 10l5 5 5-5M5 20h14"/></svg>{ui.cv_page.pdf}</a>
  </nav>

  <main class="cv-sheet">
    <CvIdentity d={d} siteUrl={new URL(home, Astro.site).href} />

    <CvSection id="experience" title={d.sections.experience}>
      {d.experience.map((j) => <CvJob j={j} lang={lang} stackLabel={ui.stack_label} />)}
    </CvSection>

    <CvSection id="education" title={d.sections.education}>
      {d.education.map((e) => (
        <article class="cv-job">
          <h3 class="cv-job-line"><span class="cv-job-title" set:html={md(e.title)} /> <span class="cv-job-date" set:html={md(e.date)} /></h3>
          <p class="cv-text" set:html={md(e.text)} />
        </article>
      ))}
    </CvSection>

    <CvSection id="languages" title={d.sections.languages}>
      <p class="cv-text">{d.languages.map((l, i) => <Fragment>{i > 0 && <span class="cv-dot" aria-hidden="true"> · </span>}<strong set:html={md(l.name)} /> — <span set:html={md(l.level)} /></Fragment>)}</p>
    </CvSection>

    <CvSection id="interests" title={d.sections.interests}>
      {d.interests.map((t) => <p class="cv-text" set:html={md(t)} />)}
    </CvSection>
  </main>
</body>
</html>

---
// La page du CV, pour une langue. Anglais à la racine (src/pages/index.astro), français sous /fr/.
import { getEntry } from 'astro:content';
import '../styles/index.css';   // tout le style, dans l'ordre de la cascade
import Head from '../components/Head.astro';
import Topbar from '../components/Topbar.astro';
import Hero from '../components/Hero.astro';
import Experience from '../components/Experience.astro';
import Facts from '../components/Facts.astro';
import Footer from '../components/Footer.astro';
import { pathOf, type Lang } from '../lib/i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
const entry = await getEntry('cv', lang);
if (!entry) throw new Error(`Contenu manquant : src/content/cv/${lang}.json`);
const d = entry.data;
const fullName = `${d.identity.first_name} ${d.identity.last_name}`;
---
<!DOCTYPE html>
<html lang={lang}>
<head>
  <Head lang={lang} d={d} fullName={fullName} />
</head>
<body id="top">
  <a class="skip-link" href="#experience">{d.ui.skip_link}</a>

  <Topbar d={d} fullName={fullName} home={pathOf(lang)} />

  <div class="page">
  <Hero d={d} fullName={fullName} />

  <main>
  <Experience d={d} />
  <Facts d={d} />
  </main>
  </div>

  <Footer d={d} />

  <script>
    // Tous les scripts de la page, dans un seul fichier : mesuré le 22/09/2026, 2 fichiers au chargement (13,1 ko) contre
    // 6 (14,3 ko, certains en cascade) quand chaque composant déclare les siens. L'ordre est celui d'exécution.
    import '../components/ThemeToggle.js';  // l'interrupteur jour / nuit
    import '../scripts/ui/navigation.js';   // la page : repère, mode scène, défilement
    import '../components/Topbar.js';       // la barre : le logo recharge la page
    import '../scripts/ui/cursor.js';       // la page : curseur
    import '../scripts/ui/fps.js';          // la page : ?fps
    import '../scripts/3d/hero.js';         // Hero : les téléphones (Three.js chargé à la demande)
    import '../scripts/3d/logo.js';         // Topbar : le logo AF
    import '../scripts/3d/marks.js';        // Hero et Topbar : Betclic, Accor, LinkedIn
  </script>
</body>
</html>

---
// The CV page, for one language. English at the root (src/pages/index.astro), French under /fr/.
import { getEntry } from 'astro:content';
import '../styles/index.css';   // all the styles, in cascade order
import Head from '../components/Head.astro';
import Topbar from '../components/Topbar.astro';
import Hero from '../components/Hero.astro';
import Experience from '../components/Experience.astro';
import Facts from '../components/Facts.astro';
import Footer from '../components/Footer.astro';
import { pathOf, type Lang } from '../lib/i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
const entry = await getEntry('cv', lang);
if (!entry) throw new Error(`Missing content: src/content/cv/${lang}.json`);
const d = entry.data;
const fullName = `${d.identity.first_name} ${d.identity.last_name}`;
---
<!DOCTYPE html>
<html lang={lang}>
<head>
  <Head lang={lang} d={d} fullName={fullName} />
</head>
<body id="top" data-pager-label={d.ui.pager_aria} data-pager-passed={d.ui.pager_passed} data-pager-done={d.ui.pager_done} data-tab-away={d.ui.tab_away}>
  <a class="skip-link" href="#experience">{d.ui.skip_link}</a>

  <Topbar d={d} fullName={fullName} home={pathOf(lang)} />

  <div class="page">
  <Hero d={d} fullName={fullName} />

  <main>
  <Experience d={d} />
  <Facts d={d} />
  </main>
  </div>

  <Footer d={d} />
  <canvas class="devices3d" aria-hidden="true"></canvas>

  <script>
    // All the page's scripts, in a single file: measured on 2026-09-22, 2 files on load (13.1 KB) versus 6 (14.3 KB, some
    // chained) when each component declares its own. The order is the execution order.
    import '../components/ThemeToggle.js';  // the light / dark switch
    import '../scripts/ui/sound.js';        // the sound switch and the synthesised sounds
    import '../scripts/ui/pager.js';        // the page: the screens and their progress indicator
    import '../scripts/ui/stage.js';        // the page: stage mode (computer)
    import '../scripts/ui/scroll.js';       // the page: normal scrolling (everything else)
    import '../components/Topbar.js';       // the top bar: the logo reloads the page
    import '../scripts/ui/cursor.js';       // the page: cursor
    import '../scripts/ui/magnetic.js';     // the page: buttons that lean towards the mouse
    import '../scripts/ui/tab.js';          // the page: the tab's title while the visitor is away
    import '../scripts/ui/fps.js';          // the page: ?fps
    import '../scripts/3d/hero.js';         // Hero: the phones (Three.js loaded on demand)
    import '../scripts/3d/logo.js';         // Topbar: the AF logo
    import '../scripts/3d/marks.js';        // Hero and Topbar: Betclic, Accor, LinkedIn
    import '../scripts/3d/skills.js';       // Footer: the skills fall in as 3D pills
  </script>
</body>
</html>

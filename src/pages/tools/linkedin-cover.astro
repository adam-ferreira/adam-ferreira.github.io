---
// LinkedIn banner (1584 × 396) made from the site's building blocks: the frozen phone scene (data-freeze), Humane.
// Export: npm run build && npm run preview, then headless Chrome on http://localhost:4321/tools/linkedin-cover/ with
// --window-size=1584,396 --force-device-scale-factor=2 --screenshot. The LinkedIn profile photo covers the bottom-left
// corner: nothing important there. The page is published but not indexed.
// It loads the site's base stylesheet and wears its dark theme, so the fonts and the colours follow the site.
import '../../styles/base.css';
---
<!doctype html>
<html lang="en" data-theme="dark">
<head>
<meta charset="utf-8">
<meta name="robots" content="noindex">
<title>LinkedIn banner</title>
<style is:global>
  .cover {
    position: relative; width: 1584px; height: 396px; overflow: hidden; color: var(--ink);
    /* the banner is exported as an image: keep the plain text rendering it was exported with, not the page's */
    -webkit-font-smoothing: auto; text-rendering: auto;
    background:
      radial-gradient(560px 440px at 1300px 200px, color-mix(in srgb, var(--accent) 30%, transparent), transparent 70%),
      radial-gradient(900px 520px at 0 0, rgba(255, 255, 255, .04), transparent 60%),
      var(--paper);
  }
  .cover::before {   /* a very fine grid that fades out towards the edges */
    content: ""; position: absolute; inset: 0;
    background-image: linear-gradient(rgba(255, 255, 255, .035) 1px, transparent 1px), linear-gradient(90deg, rgba(255, 255, 255, .035) 1px, transparent 1px);
    background-size: 44px 44px;
    -webkit-mask-image: linear-gradient(90deg, transparent 0, #000 25%, #000 75%, transparent); mask-image: linear-gradient(90deg, transparent 0, #000 25%, #000 75%, transparent);
  }
  .statement { position: absolute; left: 400px; top: 76px; margin: 0; font-family: var(--display); font-weight: 400; text-transform: uppercase; font-size: 208px; line-height: .86; letter-spacing: .01em; white-space: nowrap; }
  .statement em { font-style: normal; color: var(--accent); }
  .meta { position: absolute; left: 404px; top: 334px; display: flex; gap: 30px; font: 500 14px var(--mono); letter-spacing: .16em; text-transform: uppercase; color: var(--muted); }
  .meta b { font-weight: 500; color: var(--ink); }
  .meta .site { color: var(--accent); }
  canvas.hero3d { position: absolute; left: 1050px; top: -78px; width: 560px; height: 560px; display: block; }
</style>
</head>
<body>
  <div class="cover">
    <p class="statement">Ship it. <em>Tested it.</em></p>
    <div class="meta"><b>Software Engineer · Dev &amp; QA Automation</b><span class="site">adam-ferreira.github.io</span></div>
    <canvas class="hero3d" data-freeze="4.81"></canvas>
  </div>
  <script>import '../../scripts/3d/hero.js';</script>
</body>
</html>

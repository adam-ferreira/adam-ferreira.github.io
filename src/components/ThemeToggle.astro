---
// Interrupteur jour / nuit, dans la barre. Le thème choisi est mémorisé ; sans choix, celui du système.
// Style : ThemeToggle.css. Script : ThemeToggle.js (chargé par la page, Cv.astro).
import type { Cv } from '../lib/types';
interface Props { ui: Cv['ui'] }
const { ui } = Astro.props;
---
<button class="theme-toggle" type="button" role="switch" aria-checked="false" aria-label={ui.toggle_aria} title={ui.toggle_title_light} data-title-light={ui.toggle_title_light} data-title-dark={ui.toggle_title_dark}>
  <span class="tt-icon tt-sun"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"/></svg></span>
  <span class="tt-icon tt-moon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg></span>
  <span class="tt-knob"></span>
</button>

---
// One experience on the CV page: role — client and dates, the home page's lead, each achievement as its bold title then
// its CV text (a little more than the home page's short sentence), the stack. Style: CvPage.css.
import { md } from '../lib/text';
import type { Job } from '../lib/types';
interface Props { j: Job; lang: 'en' | 'fr'; stackLabel: string }
const { j, lang, stackLabel } = Astro.props;
const colon = lang === 'fr' ? ' :' : ':';   // md() ties the French one to its word
const intro = j.lead ?? j.intro;
---
<article class="cv-job">
  <h3 class="cv-job-line"><span class="cv-job-title" set:html={md(j.client ? `${j.role} — ${j.client}` : j.role)} /> <span class="cv-job-date" set:html={md(j.date)} /></h3>
  {intro && <p class="cv-text" set:html={md(intro)} />}
  {j.bullets && (
    <ul class="cv-bullets">
      {j.bullets.map((b) => <li><strong set:html={md(`${b.title}${colon}`)} /> <span set:html={md(b.text)} /></li>)}
    </ul>
  )}
  {j.stack && (   /* one tag per tool; real spaces between them, so a PDF parser still reads the words apart */
    <p class="cv-stack"><span class="cv-stack-label" set:html={md(stackLabel.replace(/\s*:\s*$/, ''))} /> <Fragment set:html={j.stack.map((t) => `<span class="cv-tag">${md(t)}</span>`).join(' ')} /></p>
  )}
</article>

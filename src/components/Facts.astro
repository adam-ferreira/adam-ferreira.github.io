---
// The last content screen: education, languages, interests.
import EntryHeader from './EntryHeader.astro';
import Section from './Section.astro';
import { md, plain } from '../lib/text';
import type { Cv } from '../lib/types';
interface Props { d: Cv }
const { d } = Astro.props;
const langs = d.languages.map((l) => `<strong>${md(l.name)}</strong> &mdash; ${md(l.level)}`).join(' &nbsp;&middot;&nbsp; ');
---
<div class="facts slide" data-label={plain(d.sections.education)}>
  <Section id="education" title={d.sections.education} reveal>
    {d.education.map((e) => (
      <Fragment>
        <EntryHeader title={e.title} date={e.date} />
        <p class="prose reveal" set:html={md(e.text)} />
      </Fragment>
    ))}
  </Section>
  <Section id="languages" title={d.sections.languages} reveal>
    <p class="prose reveal" set:html={langs} />
  </Section>
  <Section id="interests" title={d.sections.interests} reveal>
    {d.interests.map((i) => <p class="prose reveal" set:html={md(i)} />)}
  </Section>
</div>

---
// Le dernier écran de contenu : formation, langues, centres d'intérêt.
import EntryHeader from './EntryHeader.astro';
import SectionTitle from './SectionTitle.astro';
import { md } from '../lib/text';
import type { Cv } from '../lib/types';
interface Props { d: Cv }
const { d } = Astro.props;
const langs = d.languages.map((l) => `<strong>${md(l.name)}</strong> &mdash; ${md(l.level)}`).join(' &nbsp;&middot;&nbsp; ');
---
<div class="facts slide">
  <section class="section" id="education" aria-labelledby="education-title">
    <SectionTitle id="education" label={d.sections.education} />
    {d.education.map((e) => (
      <Fragment>
        <EntryHeader title={md(e.title)} date={e.date} />
        <p class="job-intro reading" set:html={md(e.text)} />
      </Fragment>
    ))}
  </section>
  <section class="section" id="languages" aria-labelledby="languages-title">
    <SectionTitle id="languages" label={d.sections.languages} />
    <p class="job-intro reading" set:html={langs} />
  </section>
  <section class="section" id="interests" aria-labelledby="interests-title">
    <SectionTitle id="interests" label={d.sections.interests} />
    {d.interests.map((i) => <p class="job-intro reading" set:html={md(i)} />)}
  </section>
</div>

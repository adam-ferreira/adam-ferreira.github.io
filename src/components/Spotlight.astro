---
// Header of an experience whose phones play its test: the client's logo in 3D (its name when it has no mark), and the
// role held there (without its parenthesis: the platform is in the intro), then the contract and the dates. One heading
// for the logo and the role, for screen readers: the logo is named by its alt text. Style: Spotlight.css.
import Mark from './Mark.astro';
import { contractAndDates, md, withoutNote } from '../lib/text';
import type { MarkData } from '../lib/types';
interface Props { role: string; client: string; date: string; mark?: { name: string; data: MarkData } }
const { role, client, date, mark } = Astro.props;
const [, name, note] = client.match(/^(.*?)\s*(\(.*\))?$/) ?? [, client];
---
<header class="spotlight reveal">
  <h3 class="spotlight-title">
    <span class="spotlight-name">{mark ? <Mark name={mark.name} mark={mark.data} class="spotlight-mark" /> : name}{note && <small>{note}</small>}</span>
    <span class="spotlight-role" set:html={md(withoutNote(role))} />
  </h3>
  <p class="spotlight-when" set:html={md(contractAndDates(date))} />
</header>

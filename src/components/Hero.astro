---
// The hero: the 3D scene with the phones, the portrait, the name, the hero sentence with its brand marks, the contact
// details. Style: Hero.css. Script: src/scripts/3d/hero.js — loaded by the page (Cv.astro) in a single file.
import portrait280 from '../assets/portrait-280.webp?url';
import portrait420 from '../assets/portrait.webp?url';
import heroPoster from '../assets/devices/hero.webp?url';   // the phones as a still image (npm run posters)
import HeroLine from './HeroLine.astro';
import PillLink from './PillLink.astro';
import { md } from '../lib/text';
import { monthYear } from '../lib/updated';
import type { Cv } from '../lib/types';
interface Props { d: Cv; fullName: string }
const { d, fullName } = Astro.props;
const idn = d.identity, ui = d.ui;
---
<header class="header slide" data-label={ui.home_label}>
  <div class="hero-stage" aria-hidden="true"><img class="device-poster hero-poster" src={heroPoster} alt="" width="719" height="719" decoding="async"><canvas class="hero3d"></canvas></div>
  <div class="header-left">
    <div class="portrait"><span class="portrait-disc" aria-hidden="true"></span><img src={portrait280} srcset={`${portrait280} 280w, ${portrait420} 420w`} sizes="(max-width: 560px) 84px, 128px" alt={fullName} class="portrait-img" width="420" height="562" fetchpriority="high"></div>
    <div class="header-name-block">
      <!-- two spans: each word is shaped on its own, as the giant name was drawn (one run kerns differently) -->
      <h1 class="name"><span>{idn.first_name}</span> <span>{idn.last_name}</span></h1>
      <p class="subtitle" set:html={md(idn.headline)} />
      <HeroLine hero={idn.hero} marks={idn.marks} />
      <p class="location">
        <span class="flag" aria-hidden="true"><span class="flag-blue"></span><span class="flag-white"></span><span class="flag-red"></span></span><span class="meta-item">{idn.location}</span> <span class="meta-item">{idn.status_freelance}</span> <span class="meta-item">{idn.status_mode}</span>
      </p>
      <p class="contact">
        <PillLink href={`mailto:${idn.contact.email}`}><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2.5"/><path d="m4 7 8 6 8-6"/></svg><span>{idn.contact.email}</span></PillLink>
        <PillLink href={`tel:${idn.contact.phone_href}`}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 4h3.5l1.6 4.2-2.2 1.4a11 11 0 0 0 6.5 6.5l1.4-2.2L20 15.5V19a1.5 1.5 0 0 1-1.6 1.5A16.5 16.5 0 0 1 3.5 5.6 1.5 1.5 0 0 1 5 4Z"/></svg><span>{idn.contact.phone}</span></PillLink>
      </p>
    </div>
  </div>
  <div class="hero-foot">
    <span class="label" set:html={md(ui.updated.replace('{date}', monthYear(d.lang)))} />
    <span class="label scroll-hint" set:html={md(ui.scroll_hint)} />
  </div>
</header>


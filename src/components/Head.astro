---
// Le contenu du <head> : la politique de sécurité (CSP), le script qui prépare l'affichage, le titre et la description,
// l'aperçu de partage (Open Graph), la fiche pour les moteurs de recherche (schema.org), les langues (canonique,
// hreflang), l'icône, le préchargement des deux polices. Le style et les scripts de la page, Astro les ajoute lui-même.
import { createHash } from 'node:crypto';
import logoUrl from '../assets/logo.png?url';
import bricolageUrl from '../assets/fonts/BricolageGrotesque-fr.woff2?url';
import humaneUrl from '../assets/fonts/Humane-name.woff2?url';
import { pathOf, LOCALE, type Lang } from '../lib/i18n';
import type { Cv } from '../lib/types';
interface Props { lang: Lang; d: Cv; fullName: string }
const { lang, d, fullName } = Astro.props;
const idn = d.identity;
const site = Astro.site!.href;                       // https://adam-ferreira.github.io/
const url = new URL(pathOf(lang), site).href;
const photo = new URL(idn.photo, site).href;

// Avant tout affichage : « js » (le contenu à dévoiler peut partir masqué) et, sur ordinateur à la souris, le mode scène.
const BOOT = 'document.documentElement.classList.add("js");if (matchMedia("(min-width: 1100px) and (min-height: 680px) and (hover: hover) and (pointer: fine)").matches) document.documentElement.classList.add("stage")';
const sha256 = (s: string) => `'sha256-${createHash('sha256').update(s).digest('base64')}'`;
// Politique de sécurité : rien ne vient d'ailleurs que du site ; le seul script écrit dans la page est BOOT, autorisé par
// son empreinte (tout autre script injecté serait bloqué). style-src garde 'unsafe-inline' : la feuille est intégrée à la
// page et les mots de l'accueil portent style="--i:…". En production seulement : en développement, Astro injecte ses outils.
const CSP = [
  "default-src 'self'", `script-src 'self' ${sha256(BOOT)}`, "style-src 'self' 'unsafe-inline'", "img-src 'self' data: blob:",
  "font-src 'self'", "connect-src 'self'", "object-src 'none'", "base-uri 'self'", "form-action 'none'",
].join('; ');

// La fiche « Person » lue par les moteurs de recherche (schema.org).
const person = {
  '@context': 'https://schema.org', '@type': 'Person',
  name: fullName, jobTitle: idn.headline, description: idn.tagline, url: site, image: photo,
  email: `mailto:${idn.contact.email}`, telephone: idn.contact.phone_href,
  address: { '@type': 'PostalAddress', addressLocality: idn.location.split(',')[0].trim(), addressCountry: 'FR' },
  knowsLanguage: d.languages.map((l) => l.name),
  sameAs: [idn.linkedin.url],
};
const ld = JSON.stringify(person).replace(/</g, '\\u003c');
---
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
{import.meta.env.PROD && <meta http-equiv="Content-Security-Policy" content={CSP}>}
<meta name="referrer" content="strict-origin-when-cross-origin">
<script is:inline set:html={BOOT}></script>
<title>{d.meta.title}</title>
<meta name="description" content={d.meta.description}>
<meta name="theme-color" content="#f6f7f9" media="(prefers-color-scheme: light)">
<meta name="theme-color" content="#0e1116" media="(prefers-color-scheme: dark)">
<meta property="og:type" content="profile">
<meta property="og:title" content={`${fullName} — ${idn.headline}`}>
<meta property="og:description" content={idn.tagline}>
<meta property="og:url" content={url}>
<meta property="og:image" content={photo}>
<meta property="og:image:width" content="800">
<meta property="og:image:height" content="800">
<meta property="og:image:alt" content={fullName}>
<meta property="og:locale" content={LOCALE[lang]}>
<meta name="twitter:card" content="summary">
<link rel="canonical" href={url}>
<link rel="alternate" hreflang="en" href={new URL(pathOf('en'), site).href}>
<link rel="alternate" hreflang="fr" href={new URL(pathOf('fr'), site).href}>
<link rel="alternate" hreflang="x-default" href={site}>
<link rel="icon" href={logoUrl} type="image/png">
<link rel="apple-touch-icon" href={logoUrl}>
<link rel="preload" as="font" type="font/woff2" href={bricolageUrl} crossorigin>
<link rel="preload" as="font" type="font/woff2" href={humaneUrl} crossorigin>
<script type="application/ld+json" set:html={ld}></script>

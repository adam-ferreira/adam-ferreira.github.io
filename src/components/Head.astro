---
// The <head> of a page about Adam — the home page, the detailed CV or the Lab: everything that is specific to it — title
// and description, share preview (Open Graph), card for search engines (schema.org), languages (canonical, hreflang).
// What every page shares is in BaseHead.astro.
import BaseHead from './BaseHead.astro';
import { LANGS, pathOf, cvPathOf, labPathOf, LOCALE, type Lang } from '../lib/i18n';
import type { Cv } from '../lib/types';
import heroPoster from '../assets/devices/hero.webp?url';
interface Props { lang: Lang; d: Cv; fullName: string; page?: 'home' | 'cv' | 'lab' }
const { lang, d, fullName, page = 'home' } = Astro.props;
const idn = d.identity;
const home = page === 'home', lab = page === 'lab';
const pathFor = home ? pathOf : lab ? labPathOf : cvPathOf;
const site = Astro.site!.href;                       // https://adam-ferreira.github.io/
const url = new URL(pathFor(lang), site).href;
const photo = new URL(idn.photo, site).href;
const title = home ? d.meta.title : `${fullName} — ${lab ? d.lab.link : d.ui.cv_page.title}`;
const description = home ? d.meta.description : lab ? d.lab.description : d.meta.cv_description;

// The card read by search engines (schema.org): the CV pages are a ProfilePage about the Person, the Lab a page of
// their work (CollectionPage) whose author is that same Person.
const person = {
  '@type': 'Person', '@id': `${site}#person`,
  name: fullName, jobTitle: idn.headline, description: idn.tagline, url: site, image: photo,
  email: `mailto:${idn.contact.email}`,
  address: { '@type': 'PostalAddress', addressLocality: idn.location.split(',')[0].trim(), addressCountry: 'FR' },
  knowsLanguage: d.languages.map((l) => l.name),
  knowsAbout: d.skills.flatMap((s) => s.items),
  alumniOf: d.education.map((e) => ({ '@type': 'EducationalOrganization', name: e.title.split(' — ')[0] })),
  sameAs: [idn.linkedin.url, 'https://github.com/adam-ferreira'],
};
const profile = lab
  ? { '@context': 'https://schema.org', '@type': 'CollectionPage', url, inLanguage: lang, name: title, description, author: person }
  : { '@context': 'https://schema.org', '@type': 'ProfilePage', url, inLanguage: lang, mainEntity: person };
const ld = JSON.stringify(profile).replace(/</g, '\\u003c');
---
<BaseHead stage={home} paper={page === 'cv'} />
<title>{title}</title>
<meta name="description" content={description}>
<meta property="og:type" content="profile">
<meta property="og:title" content={`${fullName} — ${idn.headline}`}>
<meta property="og:description" content={idn.tagline}>
<meta property="og:url" content={url}>
<meta property="og:image" content={new URL('og-image.jpg', site).href}>
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content={fullName}>
<meta property="og:locale" content={LOCALE[lang]}>
<meta name="twitter:card" content="summary_large_image">
<link rel="canonical" href={url}>
{LANGS.map((l) => <link rel="alternate" hreflang={l} href={new URL(pathFor(l), site).href}>)}
<link rel="alternate" hreflang="x-default" href={new URL(pathFor('en'), site).href}>
<script type="application/ld+json" set:html={ld}></script>
<!-- where the 3D does not run, the phones' still image is the largest element of the first screen: fetched early -->
{home && <link rel="preload" as="image" href={heroPoster} media="(max-width: 860px), (hover: none), (pointer: coarse)">}

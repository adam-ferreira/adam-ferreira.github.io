---
// A brand mark: Betclic and Accor in the hero sentence (HeroWord), LinkedIn in the top bar (Topbar). The image first,
// then its 3D volume: src/scripts/3d/marks.js extrudes the SVG from data-svg. With href, the mark is a link. Style: Mark.css.
interface Props {
  name: string;               // betclic, accor, linkedin → class mark-<name>
  svg: string;                // URL of the SVG to extrude in 3D
  href?: string;              // the mark is a link (opened in a new tab)
  label?: string;             // accessible name of the link
  class?: string;             // extra classes: w (a word of the hero sentence), topbar-linkedin
  style?: string;
  fillDark?: string | null;   // dark mode: color that replaces the dark faces
  darkMap?: string;           // dark mode: exact color replacements (JSON)
}
const { name, svg, href, label, class: extra, style, fillDark, darkMap } = Astro.props;
const Tag = href ? 'a' : 'span';
---
<Tag class:list={[extra, 'mark', `mark-${name}`]} href={href} target={href && '_blank'} rel={href && 'noopener'} aria-label={label} title={label}
  style={style} data-svg={svg} data-fill-dark={fillDark || undefined} data-dark-map={darkMap}><slot /></Tag>

---
// One word of the hero sentence (HeroLine): text, or a brand mark. --i sets its turn in the entrance animation (Hero.css).
import Mark from './Mark.astro';
import { md, type HeroPiece } from '../lib/text';
import type { Cv } from '../lib/types';
interface Props { p: HeroPiece; marks: Cv['identity']['marks'] }
const { p, marks } = Astro.props;
const style = `--i:${p.i}`;
const mk = 'mark' in p ? marks[p.mark] : undefined;
---
{'mark' in p && mk
  ? <Mark name={p.mark} mark={mk} class="w" style={style} />
  : <span class="w" style={style} set:html={md('text' in p ? p.text : '')} />}

---
// Giant section title (Humane). The wrapper clips the title, which slides up into view when it arrives (SectionTitle.css).
import { md } from '../lib/text';
interface Props { id: string; label: string }
const { id, label } = Astro.props;
---
<div class="section-title-wrapper"><h2 class="section-title" id={`${id}-title`} set:html={md(label)} /></div>

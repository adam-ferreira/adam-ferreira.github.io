---
// The "Experience" chapter: one screen for the big title and the skills, then one screen per experience.
import Job from './Job.astro';
import Chips from './Chips.astro';
import Section from './Section.astro';
import { md, plain } from '../lib/text';
import type { Cv } from '../lib/types';
interface Props { d: Cv }
const { d } = Astro.props;
---
<Section id="experience" title={d.sections.experience} head="chapter slide" label={plain(d.sections.experience)}>
  <div class="chapter-device device-anchor" data-demo="hero" slot="head" aria-hidden="true"></div>
  <div class="skills" slot="head">
    {d.skills.map((row) => <div class="skills-row reveal"><span class="skills-label" set:html={md(row.label)} /><Chips items={row.items} /></div>)}
  </div>
  {d.experience.map((j, i) => <Job j={j} num={String(i + 1).padStart(2, '0')} stackLabel={d.ui.stack_label} lang={d.lang} />)}
</Section>

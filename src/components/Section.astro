---
// A section of the CV, named for screen readers by its giant title (SectionTitle): the link between the two is written
// here only. `hideTitle`: the title is only read by screen readers (the experiences follow the home screen directly).
import SectionTitle from './SectionTitle.astro';
interface Props { id: string; title: string; reveal?: boolean; hideTitle?: boolean }   // reveal: the title settles in with the rest of its screen
const { id, title, reveal, hideTitle } = Astro.props;
const titleId = `${id}-title`;
---
<section class:list={['section', { 'is-untitled': hideTitle }]} id={id} aria-labelledby={titleId}>{hideTitle
  ? <h2 class="sr-only" id={titleId}>{title}</h2>
  : <SectionTitle id={titleId} label={title} class={reveal ? 'reveal' : undefined} />}<slot /></section>

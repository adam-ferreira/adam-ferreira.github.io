---
// Phone only: a contact bar at the bottom of the screen, within reach of the thumb: write (email) and share the page.
// It shows once the hero's name has left the screen and hides when the footer, which has the contact details, arrives
// (src/scripts/ui/phone.js). The share button opens the system share sheet, or copies the address where there is none.
// Style: PhoneBar.css.
import type { Cv } from '../lib/types';
interface Props { d: Cv }
const { d } = Astro.props;
const ui = d.ui.phone_bar, email = d.identity.contact.email;
---
<div class="phone-bar" role="group" aria-label={ui.aria}>
  <a class="phone-bar-mail" href={`mailto:${email}`}>
    <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2.5"/><path d="M4 7l8 6 8-6"/></svg>
    <span>{ui.mail}</span>
  </a>
  <button class="phone-bar-share" type="button" data-copied={ui.copied}>
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 15V4M8 8l4-4 4 4M6 12v6.5A1.5 1.5 0 0 0 7.5 20h9a1.5 1.5 0 0 0 1.5-1.5V12"/></svg>
    <span class="phone-bar-share-label">{ui.share}</span>
  </button>
</div>

---
// The top bar: AF logo (3D, visible outside the hero; a click reloads the page), the name that settles into it, the link
// to the detailed CV page, LinkedIn, light / dark switch (ThemeToggle). Style: Topbar.css. Scripts: Topbar.js (the logo
// reloads the page) and src/scripts/3d/logo.js, loaded by the page (Cv.astro) in a single file.
import Mark from './Mark.astro';
import ThemeToggle from './ThemeToggle.astro';
import SoundToggle from './SoundToggle.astro';
import Availability from './Availability.astro';
import logoUrl from '../assets/logo.png?url';
import { cvPathOf } from '../lib/i18n';
import type { Cv } from '../lib/types';
interface Props { d: Cv; fullName: string; home: string }   // home: URL of the page in its language (/ or /fr/)
const { d, fullName, home } = Astro.props;
const idn = d.identity, ui = d.ui;
---
<nav class="topbar" aria-label={ui.nav_aria}>
  <a class="brand" href={home} title={fullName}>
    <img class="brand-img" src={logoUrl} alt={fullName} width="46" height="46" decoding="async">
    <canvas class="logo3d" aria-hidden="true"></canvas>
  </a>
  <div class="frame-status label">
    <Availability text={ui.nav_available} />
    <span class="fs-sep" aria-hidden="true">&middot;</span>
    <a class="nocase" href={`mailto:${idn.contact.email}`}>{idn.contact.email}</a>
    <span class="fs-sep" aria-hidden="true">&middot;</span>
    <a href={`tel:${idn.contact.phone_href}`}>{idn.contact.phone}</a>
  </div>
  <a class="topbar-cv" href={cvPathOf(d.lang)} aria-label={ui.cv_page.link_title} title={ui.cv_page.link_title}>{ui.cv_page.link}</a>
  <Mark name="linkedin" mark={idn.marks.linkedin} href={idn.linkedin.url} class="topbar-linkedin" />
  <SoundToggle ui={ui} />
  <ThemeToggle ui={ui} />
</nav>


---
// La barre du haut : logo AF (3D, visible hors de l'accueil ; un clic recharge la page), nom qui s'y range, LinkedIn,
// interrupteur jour / nuit (ThemeToggle). Style : Topbar.css. Scripts : Topbar.js (le logo recharge la page) et
// src/scripts/3d/logo.js, chargés par la page (Cv.astro) dans un seul fichier.
import Mark from './Mark.astro';
import ThemeToggle from './ThemeToggle.astro';
import logoUrl from '../assets/logo.png?url';
import { markAsset } from '../lib/assets';
import type { Cv } from '../lib/types';
interface Props { d: Cv; fullName: string; home: string }   // home : adresse de la page dans sa langue (/ ou /fr/)
const { d, fullName, home } = Astro.props;
const idn = d.identity, ui = d.ui;
const li = markAsset('assets/marks/linkedin.svg'), liDark = markAsset('assets/marks/linkedin-dark.svg');
---
<nav class="topbar" aria-label={ui.nav_aria}>
  <a class="brand" href={home} title={fullName}>
    <img class="brand-img" src={logoUrl} alt={fullName} width="46" height="46" decoding="async">
    <canvas class="logo3d" aria-hidden="true"></canvas>
  </a>
  <span class="frame-status label" aria-hidden="true">{fullName} &middot; {idn.headline}</span>
  <Mark name="linkedin" svg={li.url} href={idn.linkedin.url} label="LinkedIn" class="topbar-linkedin" darkMap='{"#000000":"#ffffff"}'>
    <img class="theme-light" src={li.url} alt="" width="40" height="40" decoding="async">
    <img class="theme-dark" src={liDark.url} alt="" width="40" height="40" decoding="async">
  </Mark>
  <ThemeToggle ui={ui} />
</nav>


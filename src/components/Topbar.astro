---
// The top bar: AF logo (3D, visible outside the hero; a click reloads the page), the name that settles into it, LinkedIn,
// light / dark switch (ThemeToggle). Style: Topbar.css. Scripts: Topbar.js (the logo reloads the page) and
// src/scripts/3d/logo.js, loaded by the page (Cv.astro) in a single file.
import Mark from './Mark.astro';
import ThemeToggle from './ThemeToggle.astro';
import SoundToggle from './SoundToggle.astro';
import logoUrl from '../assets/logo.png?url';
import type { Cv } from '../lib/types';
interface Props { d: Cv; fullName: string; home: string }   // home: URL of the page in its language (/ or /fr/)
const { d, fullName, home } = Astro.props;
const idn = d.identity, ui = d.ui;
---
<nav class="topbar" aria-label={ui.nav_aria}>
  <a class="brand" href={home} title={fullName}>
    <img class="brand-img" src={logoUrl} alt={fullName} width="46" height="46" decoding="async">
    <canvas class="logo3d" aria-hidden="true"></canvas>
  </a>
  <span class="frame-status label" aria-hidden="true">{fullName} &middot; {idn.headline}</span>
  <Mark name="linkedin" mark={idn.marks.linkedin} href={idn.linkedin.url} class="topbar-linkedin" />
  <SoundToggle ui={ui} />
  <ThemeToggle ui={ui} />
</nav>


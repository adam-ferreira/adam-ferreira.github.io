---
// A section of the CV page (CvPage.astro): its micro-label title, then its content. Style: CvPage.css.
interface Props { id: string; title: string }
const { id, title } = Astro.props;
---
<section class="cv-section" aria-labelledby={`${id}-title`}>
  <h2 class="cv-section-title" id={`${id}-title`}>{title}</h2>
  <slot />
</section>

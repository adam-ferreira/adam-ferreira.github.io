{
  "name": "adam-ferreira-cv",
  "private": true,
  "type": "module",
  "description": "Adam Ferreira's web CV — static Astro site, English at the root, French under /fr/",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node tools/render-pdf.mjs",
    "pdf": "node tools/render-pdf.mjs",
    "preview": "astro preview",
    "check": "astro check",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "fonts": "uvx --from 'fonttools[woff]' python tools/subset-fonts.py",
    "posters": "node tools/render-posters.mjs"
  },
  "dependencies": {
    "astro": "7.3.3",
    "lenis": "1.3.26",
    "matter-js": "0.20.0",
    "three": "0.186.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@axe-core/playwright": "4.13.0",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "1.63.0",
    "@types/node": "24.13.6",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=22.12"
  }
}
